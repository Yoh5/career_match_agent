# Clé OpenAI — nécessaire pour l'analyse, la lettre et le CV adapté.
# Générer : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Modèle (défaut : gpt-4o-mini). Ex. gpt-4o pour plus de qualité.
OPENAI_MODEL=gpt-4o-mini

# lemlist (OPTIONNEL) — active l'envoi d'outreach recruteur (invitation/message
# LinkedIn, e-mail) via tes campagnes lemlist, avec throttling sûr côté lemlist.
# Sans clé : l'agent prépare les messages, tu les copies-colles toi-même.
# LEMLIST_API_KEY=...
